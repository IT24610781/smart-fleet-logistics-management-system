          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput
if (!vars.getObject(&apos;fixture&apos;)) {
 def f=new JsonSlurper().parse(new File(props.get(&apos;qa.fixtures&apos;)))
 vars.putObject(&apos;fixture&apos;,f)
 def login={String name -&gt;
  def c=new URL(f.authUrl+&apos;/api/auth/login&apos;).openConnection()
  c.requestMethod=&apos;POST&apos;;c.doOutput=true;c.setRequestProperty(&apos;Content-Type&apos;,&apos;application/json&apos;);c.connectTimeout=10000;c.readTimeout=15000
  c.outputStream.withCloseable {it.write(JsonOutput.toJson([username:name,password:f.password]).getBytes(&apos;UTF-8&apos;))}
  def b=new JsonSlurper().parse(c.inputStream)
  c.disconnect();return b.token
 }
 vars.put(&apos;dt&apos;,login(f.dispatcher));vars.put(&apos;drt&apos;,login(f.driver))
}
</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="US08" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput
def f=vars.getObject(&apos;fixture&apos;);def idx=ctx.threadNum*(f.loops as int)+vars.iteration-1
def codes=[]
def call={int port,String path,String method,Map body,String token -&gt;
 def c=new URL((port==5100?f.authUrl:port==5041?f.fleetUrl:f.tripUrl)+path).openConnection()
 c.requestMethod=method;c.connectTimeout=10000;c.readTimeout=15000;c.setRequestProperty(&apos;Content-Type&apos;,&apos;application/json&apos;)
 if(token)c.setRequestProperty(&apos;Authorization&apos;,&apos;Bearer &apos;+token)
 if(body!=null){c.doOutput=true;c.outputStream.withCloseable{it.write(JsonOutput.toJson(body).getBytes(&apos;UTF-8&apos;))}}
 int status=c.responseCode;codes.add(status)
 def stream=status&lt;400?c.inputStream:c.errorStream
 def text=stream!=null?stream.getText(&apos;UTF-8&apos;):&apos;&apos;
 def data=text?new JsonSlurper().parseText(text):[:];c.disconnect()
 if(status&gt;=400)throw new IllegalStateException(&apos;HTTP &apos;+status+&apos; for &apos;+path)
 return data
}
def tripBody={String label-&gt;[pickupLocation:label,dropoffLocation:&apos;QA load destination&apos;,requiredCapacity:f.requiredCapacity]}
def dt=vars.get(&apos;dt&apos;);def drt=vars.get(&apos;drt&apos;)
try {
 assert (f.threads as int)==ctx.threadGroup.numThreads : &apos;Thread count differs from prepared fixtures&apos;
 assert (f.loops as int)==(props.getProperty(&apos;qa.loops&apos;,&apos;5&apos;) as int) : &apos;Loop count differs from prepared fixtures&apos;
def name=&apos;qap&apos;+UUID.randomUUID().toString().replace(&apos;-&apos;,&apos;&apos;).substring(0,12)
call(5100,&apos;/api/auth/register/dispatcher&apos;,&apos;POST&apos;,[username:name,email:name+&apos;@example.com&apos;,password:f.password,firstName:&apos;QA&apos;,lastName:&apos;Load&apos;,contactNumber:&apos;0771234567&apos;],null)
def b=call(5100,&apos;/api/auth/login&apos;,&apos;POST&apos;,[username:name,password:f.password],null);assert b.user.role==&apos;Dispatcher&apos;
 SampleResult.setSuccessful(true);SampleResult.setResponseCode(&apos;200&apos;);SampleResult.setResponseMessage(&apos;Workflow assertions passed&apos;)
 SampleResult.setResponseData(JsonOutput.toJson([httpCodes:codes]),&apos;UTF-8&apos;)
} catch(Throwable e) {
 SampleResult.setSuccessful(false);SampleResult.setResponseCode(&apos;500&apos;);SampleResult.setResponseMessage(e.message?:e.class.simpleName)
 SampleResult.setResponseData(JsonOutput.toJson([httpCodes:codes,error:e.message]),&apos;UTF-8&apos;)
}
</stringProp>
