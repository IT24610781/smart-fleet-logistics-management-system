<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Tracking and Reporting Performance Test (SCRUM-155)">
      <stringProp name="TestPlan.comments">Sprint 4 QA. US-14 location writes, US-15 fleet map reads, US-16 history reads, US-17 fleet utilization report, plus a mixed workload. Target: p95 under 2 s (report under 5 s), error rate under 1 percent. Needs -Jqa.fixtures=...; add -Jqa.adminPassword=... to include the Admin-only report.</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
    </TestPlan>
    <hashTree>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults (TrackingTelemetryService)" enabled="true">
        <intProp name="HTTPSampler.connect_timeout">10000</intProp>
        <intProp name="HTTPSampler.response_timeout">30000</intProp>
        <stringProp name="HTTPSampler.domain">${__P(qa.trackingHost,localhost)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(qa.trackingPort,5000)}</stringProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation"></stringProp>
      </ConfigTestElement>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp: load fixtures and log in" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load fixtures and log in" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput
// Runs once, before every thread group. Fixture file comes from -Jqa.fixtures=&lt;path&gt;.
def path = props.get(&apos;qa.fixtures&apos;)
if (!path) throw new IllegalStateException(&apos;Pass -Jqa.fixtures=&lt;fixtures json&gt; (see prepare_tracking_fixtures.py)&apos;)
def f = new JsonSlurper().parse(new File(path))
props.put(&apos;qa.fixtureObj&apos;, f)
def login = { String name, String pass -&gt;
  def c = new URL(f.authUrl + &apos;/api/auth/login&apos;).openConnection()
  c.requestMethod = &apos;POST&apos;; c.doOutput = true
  c.setRequestProperty(&apos;Content-Type&apos;, &apos;application/json&apos;)
  c.connectTimeout = 10000; c.readTimeout = 15000
  c.outputStream.withCloseable { it.write(JsonOutput.toJson([username: name, password: pass]).getBytes(&apos;UTF-8&apos;)) }
  def b = new JsonSlurper().parse(c.inputStream)
  c.disconnect()
  return b.token
}

props.put(&apos;qa.dispatcherToken&apos;, login(f.dispatcher, f.password))
def adminPw = props.get(&apos;qa.adminPassword&apos;)
if (adminPw) {
  props.put(&apos;qa.adminToken&apos;, login(props.get(&apos;qa.adminUser&apos;) ?: &apos;admin&apos;, adminPw))
}
log.info(&apos;Tracking perf setup done: &apos; + f.drivers.size() + &apos; in-progress trips, admin token present: &apos; + (adminPw != null))

</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
