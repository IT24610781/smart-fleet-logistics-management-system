        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Update Vehicle" enabled="true">
          <stringProp name="HTTPSampler.path">/api/vehicles/${vehicleId}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">PUT</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{ &quot;registrationNo&quot;: &quot;${vehicleRegNo}&quot;, &quot;type&quot;: &quot;Truck&quot;, &quot;capacity&quot;: &quot;10&quot;, &quot;status&quot;: &quot;Available&quot; }</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Response Under 2s" enabled="true">
            <stringProp name="DurationAssertion.duration">2000</stringProp>
          </DurationAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="2. Stress Spike (high concurrency)">
        <stringProp name="TestPlan.comments">Ramps 60 threads in 2 seconds instead of 10 threads in 5 seconds - a near-instant burst meant to push the service into contention (DB connection pool, thread pool) rather than a gentle steady load. This is the profile that specifically targets the brief's "under stress or high concurrency" requirement.</stringProp>
        <intProp name="ThreadGroup.num_threads">60</intProp>
        <intProp name="ThreadGroup.ramp_time">2</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">3</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Login as Admin (once per thread)">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">if (!vars.getObject('loggedIn')) {
    def authUrl = props.get('qa.authUrl') ?: 'http://localhost:5100'
    def username = props.get('qa.adminUsername') ?: 'admin'
    def password = System.getenv('QA_ADMIN_PASSWORD') ?: props.get('qa.adminPassword')
    if (!password) {
        throw new RuntimeException('Launch JMeter with -Jqa.adminPassword=&lt;your admin password&gt; (and optionally -Jqa.authUrl / -Jqa.adminUsername).')
    }
    def conn = new URL(authUrl + '/api/auth/login').openConnection()
    conn.requestMethod = 'POST'
    conn.doOutput = true
    conn.setRequestProperty('Content-Type', 'application/json')
    conn.connectTimeout = 10000
    conn.readTimeout = 15000
    conn.outputStream.withCloseable { it.write(groovy.json.JsonOutput.toJson([username: username, password: password]).getBytes('UTF-8')) }
    def body = new groovy.json.JsonSlurper().parse(conn.inputStream)
    conn.disconnect()
    vars.put('authToken', body.token)
    vars.putObject('loggedIn', true)
}</stringProp>
        </JSR223PreProcessor>
