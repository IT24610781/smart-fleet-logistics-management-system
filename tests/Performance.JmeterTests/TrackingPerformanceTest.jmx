          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput
def f = props.get(&apos;qa.fixtureObj&apos;)
def login = { String name, String pass -&gt;
  def c = new URL(f.authUrl + &apos;/api/auth/login&apos;).openConnection()
  c.requestMethod = &apos;POST&apos;; c.doOutput = true
  c.setRequestProperty(&apos;Content-Type&apos;, &apos;application/json&apos;)
  c.connectTimeout = 10000; c.readTimeout = 15000
  c.outputStream.withCloseable { it.write(JsonOutput.toJson([username: name, password: pass]).getBytes(&apos;UTF-8&apos;)) }
  def b = new JsonSlurper().parse(c.inputStream)
  c.disconnect()
  return b.token
}
// Login and variable setup are pre-processors, so they are NOT part of the measured sample time.
int idx = ctx.threadNum % f.drivers.size()
def d = f.drivers[idx]
if (!vars.get(&apos;driverToken&apos;)) { vars.put(&apos;driverToken&apos;, login(d.username, f.password)) }
vars.put(&apos;tripId&apos;, d.tripId)
vars.put(&apos;observedAt&apos;, java.time.Instant.now().toString())

</stringProp>
